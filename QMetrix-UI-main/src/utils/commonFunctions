      dispatch(setLoading(true));
      dispatch(setLoadingEngMetrics(true));

      const isSprint = sessionStorage.getItem(APP_STRINGS.SESSION_TYPE_VALUE);
      const isRelease = isSprint === APP_STRINGS.VALUE_RELEASE;

      const matchQuery = {
        companyId: sessionStorage.getItem('companyId'),
        projectId: sessionStorage.getItem('projectId'),
        boardId: sessionStorage.getItem('boardId'),
        repo: sessionStorage.getItem('repo'),
        value: isRelease ? APP_STRINGS.API_RELEASE : APP_STRINGS.API_SPRINT,
        estimationType: sessionStorage.getItem('isHoursBasedProject') === 'true' ? 'hours' : 'storyPoints',
        ...(isRelease
          ? { releaseId: sessionStorage.getItem('releaseId') }
          : { sprintId: sessionStorage.getItem('sprintId') }),
      };
      // For testing purposes we are using unified endpoints. If they work properly, we will remove the commented code later.
      // const isHoursBasedProject = sessionStorage.getItem('isHoursBasedProject') === 'true';
      // const burndownVelocityQuery = {
      //   ...matchQuery,
      //   type: isHoursBasedProject ? 'hours' : 'storyPoints',
      // };

      dispatch(setSelectedDeveloperName({ value }));

      const teamPmSections = 'actualStoryPoints,burndownData,taskCount,storyPointData,availableHours,burndownVelocity,qaInsightsBugs,qaInsightsTests,qaReference';
      const fetchPromises = [
        // --- Unified project management endpoint (scoped sections for team change) ---
        fetchProjectManagementData(matchQuery, teamPmSections),
        // --- Unified standup endpoint (scoped sections for team change) ---
        fetchStandupDashboardData(matchQuery, 'jiraData,openPRs,mergedWithoutReview,storyChurn,storyChurnExcludingBugs,dailyBurnup'),
        // --- Unified CXO endpoint (scoped for team change) ---
        fetchCXODashboardData(matchQuery, 'cxoData'),
        // For testing purposes we are using this change. If this endpoint works properly, we will remove the commented code later.
        // fetchData(getjiraTableData, setJiraTableData, matchQuery),
        // fetchData(getOpenPRsData, setStandupOpenPRsData, matchQuery),
        // fetchData(getMergedPRsWithoutReviewData, setStandupMergedPRsData, matchQuery),
        // fetchData(getReleaseReadinessDetails, addReleaseReadinessData, matchQuery),
      ];

      await Promise.all(fetchPromises);
    } catch (error) {
      console.error('Error resetting sprint and release:', error);
    } finally {
      dispatch(setLoading(false));
      dispatch(setLoadingEngMetrics(false));
    }
  };

  const resetData = () => {
    store.dispatch(resetCXO());
    store.dispatch(resetSonarQubeData());
    dispatch(setVelocityData([]));
    dispatch(setBugClassification([]));
    dispatch(setCostOfFixingDefect([]));
    dispatch(setTimeToFix([]));
    dispatch(setDefectDensity([]));
    dispatch(setTaskCountData([]));
    dispatch(setStatusCountData([]));
    dispatch(setStoryPointsData([]));
    dispatch(setClosedPRs([]));
    dispatch(setLeadTimeChanges([]));
    dispatch(setTotalPRs([]));
    dispatch(setOpenPRs([]));
    dispatch(setPRSize([]));
    dispatch(setGitCycleTime([]));
    dispatch(setApprovalRate([]));
    dispatch(setMergedWithoutReviewPRs([]));
    dispatch(setDefectRejection([]));
    dispatch(setDefectRemovalEfficiency([]));
    dispatch(setIterationTime([]));
    dispatch(setGetDoraData([]));
