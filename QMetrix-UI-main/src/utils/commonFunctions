    dispatch(setStoryChurnData([]));
    dispatch(setCycleTime([]));
    dispatch(setSprintCompleteDate([]));
    dispatch(setAvailableHours([]));
    dispatch(setUserList([]));
  };
  const handleValue = () => {
    try {
      resetData();
      sessionStorage.removeItem('sprintId');
      sessionStorage.removeItem('sprintName');
      sessionStorage.removeItem('releaseId');
      sessionStorage.removeItem('releaseName');
      sessionStorage.removeItem(APP_STRINGS.SESSION_TYPE_VALUE);
      sessionStorage.removeItem(APP_STRINGS.SESSION_TYPE_VALUE_LABEL);
      sessionStorage.removeItem('developer');
      sessionStorage.removeItem('velocityToggleType');
      sessionStorage.removeItem('velocityToggleTypeManual');
      dispatch(setSelectedDeveloperName(''));
      dispatch(setSelectedSprint({ selectedSprintId: '', selectedSprintName: '' }));
      dispatch(setSelectedRelease({ selectedReleaseId: '', selectedReleaseName: '' }));
    } catch (error) {
      console.error('Error resetting sprint and release:', error);
    }
  };

  useEffect(() => {
    if (!refreshToken) return;
    if (refreshInFlightRef.current) return;

    const companyId = sessionStorage.getItem('companyId');
    const projectId = sessionStorage.getItem('projectId');
    const boardId = sessionStorage.getItem('boardId');
    if (!projectId || !boardId) return;

    const typeValue = sessionStorage.getItem(APP_STRINGS.SESSION_TYPE_VALUE);
    const sprintId = sessionStorage.getItem('sprintId');
    const releaseId = sessionStorage.getItem('releaseId');

    const dedupeKey = `${refreshToken}|${companyId || ''}|${projectId}|${boardId}|${typeValue || ''}|${sprintId || ''}|${releaseId || ''}`;
    if (dedupeKey === lastCompletedJiraRefreshTokenEffectKey) {
      return;
    }
    if (dedupeKey === jiraRefreshTokenEffectInFlightKey) {
      return;
    }
    jiraRefreshTokenEffectInFlightKey = dedupeKey;

    refreshInFlightRef.current = true;
    Promise.resolve()
      .then(async () => {
        if (typeValue === APP_STRINGS.VALUE_RELEASE && releaseId) {
          await handleRelease(releaseId, true);
        } else if (sprintId) {
          await handleSprint(sprintId, undefined, true);
        }
      })
      .finally(() => {
        refreshInFlightRef.current = false;
        if (jiraRefreshTokenEffectInFlightKey === dedupeKey) {
          jiraRefreshTokenEffectInFlightKey = null;
        }
        lastCompletedJiraRefreshTokenEffectKey = dedupeKey;
      });
    // Intentionally refreshToken only: module-level dedupe avoids remount duplicate calls; adding handleRelease/handleSprint would refire every render.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [refreshToken]);

  return {
    handleProject,
    handleSprint,
    handleRelease,
    handleRepo,
    handleValue,
    handleDeveloper,
    handleTeam,
    handleOrganization,
    fetchData,
    updateCapacityValues,
    fetchProjectManagementData,
  };
};
export function getMetricValue({
  selectedValue,
  toggleType,
  selectedSprintData,
  selectedReleaseData,
  metricType,
}) {
  const value = typeof selectedValue === 'string' ? selectedValue : selectedValue?.value;
  const sourceData = value === APP_STRINGS.VALUE_SPRINT ? selectedSprintData : selectedReleaseData;
  if (!sourceData) return 0;
  const cleanMetricType = metricType.trim();
  const lowerCaseMetricType = cleanMetricType.toLowerCase();
  let key;
  if (lowerCaseMetricType.includes('storypoints') || lowerCaseMetricType.includes('hours')) {
    key = cleanMetricType;
  } else {
    const suffix = toggleType === APP_STRINGS.STORY_POINTS ? 'StoryPoints' : APP_STRINGS.HOURS;
    key = `${cleanMetricType}${suffix}`;
  }
  return sourceData?.[key] ?? 0;
}

export function formatNumberWithSuffix(value, decimals = 0) {
  if (value === null || value === undefined || isNaN(value)) {
    return { formatted: '0', original: 0 };
  }

  const num = parseFloat(value);
  const absNum = Math.abs(num);

  if (absNum < 1000) {
    return {
      formatted: num.toString(),
      original: num,
    };
  } else if (absNum < 100000) {
    // For 1,000 to 99,999 - show as K
    const formatted = (num / 1000).toFixed(decimals);
    return {
      formatted: `${formatted}K`,
      original: num,
    };
  } else if (absNum < 10000000) {
    // For 100,000 to 9,999,999 - show as L (Lakhs)
    const formatted = (num / 100000).toFixed(decimals);
    return {
      formatted: `${formatted}L`,
      original: num,
    };
  } else {
    // For 10,000,000 and above - show as M (Millions)
    const formatted = (num / 1000000).toFixed(decimals);
    return {
      formatted: `${formatted}M`,
      original: num,
    };
  }
}
