const TECH_QUALITY_PATH = '/techQuality';
const DASHBOARD_PATH = '/dashboard';
const STANDUP_PATH = '/standUp';
const JIRA_PATH = '/jiraDashboard';
const GIT_PATH = '/gitDashboard';
const RELEASE_DASHBOARD_PATH = '/release';

// Deduplicate refreshToken-driven refetch across multiple CommonFunction() instances
// (each page mounts its own hook; React still runs mount effects even when Redux refreshToken is unchanged).
let lastCompletedJiraRefreshTokenEffectKey = null;
let jiraRefreshTokenEffectInFlightKey = null;

export const CommonFunction = () => {
  const dispatch = useDispatch();
  const location = useLocation();
  const refreshToken = useSelector((state) => state?.jira?.refreshToken);
  const refreshInFlightRef = useRef(false);
  const orgListFetchInFlightRef = useRef(false);
  let repo = sessionStorage.getItem('repo');
  const isTechQualityPage = location?.pathname === TECH_QUALITY_PATH;
  const isReleaseDashboardPage = location?.pathname === RELEASE_DASHBOARD_PATH;

  // For testing purposes we are using unified endpoints. If they work properly, we will remove the commented code later.
  // const getChurnApi = () => {
  //   const exclude = sessionStorage.getItem('excludeBugsInChurn') === 'true';
  //   return exclude ? getStoryChurnExcludingBugs : getStoryChurnData;
  // };

  const fetchData = async (apiCall, action, params) => {
    try {
      const response = await apiCall(params);
      const isQARefrenceCall =
        action === setQAReferenceData ||
        (typeof apiCall === 'function' && apiCall.toString().includes('getQARefrence'));
      if (isQARefrenceCall) {
        if (
          !response ||
          !response.data ||
          (typeof response.data === 'object' && Object.keys(response.data).length === 0)
        ) {
          dispatch(action(null));
          return;
        }
      }
     dispatch(action(response.data));
    } catch (error) {
      const isQARefrenceCall =
        action === setQAReferenceData ||
        (typeof apiCall === 'function' && apiCall.toString().includes('getQARefrence'));

      if (isQARefrenceCall) {
        dispatch(action(null));
      }
    }
  };
  const getRepositoryPlatform = (repos = []) => {
    if (!Array.isArray(repos) || repos.length === 0) return 'unknown';

    const isGitLab = repos.some((repo) => typeof repo === 'string' && repo.includes('gitlab.com'));
    const isGitHub = repos.some((repo) => typeof repo === 'string' && repo.includes('github.com'));

    if (isGitLab) return 'GitLab';
    if (isGitHub) return 'GitHub';
    return 'unknown';
  };

  useEffect(() => {
    const companyId = sessionStorage.getItem('companyId');
    if (!companyId) return;
    const cachedOrgs = store.getState()?.jira?.organizationList;
    if (cachedOrgs?.length > 0) return;
    if (orgListFetchInFlightRef.current) return;

    orgListFetchInFlightRef.current = true;
    Promise.resolve()
      .then(async () => {
        const organizations = await getAllOrgsListAPI();
        if (Array.isArray(organizations) && organizations.length > 0) {
          dispatch(setOrganizationList(organizations));
        }
      })
      .catch((error) => {
        console.error('Error fetching organization list:', error);
      })
      .finally(() => {
        orgListFetchInFlightRef.current = false;
      });
  }, [dispatch]);

  // This runs once on mount to restore session selections; intentionally not re-run.
  useEffect(() => {
    const hasRefreshed = sessionStorage.getItem('hasRefreshed');

    if (!hasRefreshed) {
      sessionStorage.setItem('hasRefreshed', 'true');

      const fetchAndSetData = async () => {
        const storedProjectId = sessionStorage.getItem('projectId');
        const storedProjectName = sessionStorage.getItem('projectName');
        const storedSprintId = sessionStorage.getItem('sprintId');
        const storedSprintName = sessionStorage.getItem('sprintName');
        const storedReleaseId = sessionStorage.getItem('releaseId');
        const storedReleaseName = sessionStorage.getItem('releaseName');
        const storedRepo = sessionStorage.getItem('repo');
        const storedTypeValue = sessionStorage.getItem(APP_STRINGS.SESSION_TYPE_VALUE);
        const storedTypeValueLabel = sessionStorage.getItem(APP_STRINGS.SESSION_TYPE_VALUE_LABEL);
        const orgId = sessionStorage.getItem('orgId');
        const orgName = sessionStorage.getItem('orgName');

        dispatch(
          setSelectedOrganization({
            selectedOrgName: orgName,
            selectedOrgId: orgId,
          }),
        );

        const existingState = store.getState()?.jira;
        const hasProjectListInRedux = existingState?.projectList?.length > 0;

        if (hasProjectListInRedux) {
          const selectedProject = existingState.projectList.find((p) => p._id === storedProjectId);
          const repositoryPlatform = getRepositoryPlatform(selectedProject?.repos);
          dispatch(setRepositoryProvider({ repositoryProvider: repositoryPlatform }));
        } else {
          try {
            const projects = await getProjectList();
            dispatch(setProjectList(projects.data));
            const selectedProject = projects.data.find((project) => project._id === storedProjectId);
            const repositoryPlatform = getRepositoryPlatform(selectedProject?.repos);
            dispatch(setRepositoryProvider({ repositoryProvider: repositoryPlatform }));
          } catch (error) {
            console.error('Error fetching project list:', error);
          }
        }

        if (storedProjectId && storedProjectName) {
          dispatch(
            setSelectedProject({
              selectedProjectName: storedProjectName,
              selectedProjectId: storedProjectId,
            }),
          );

          if (!isTechQualityPage) {
            const hasSprintsInRedux = existingState?.sprintList?.length > 0;
            const hasReleasesInRedux = existingState?.releasesList?.length > 0;
            const hasReposInRedux = existingState?.repoList?.length > 0;

            if (!hasSprintsInRedux) {
              fetchData(getSprintList, setSprintList, {
                projectId: storedProjectId,
                boardId: sessionStorage.getItem('boardId'),
              });
            }
            if (!hasReleasesInRedux) {
              fetchData(getReleaseDetails, setReleasesList, {
                projectId: storedProjectId,
                boardId: sessionStorage.getItem('boardId'),
              });
            }
            if (!hasReposInRedux) {
              fetchData(getRepoList, setRepoList, {
                companyId: sessionStorage.getItem('companyId'),
                projectId: storedProjectId,
              });
            }
          }
        }

        if (!isTechQualityPage) {
          if (isReleaseDashboardPage) {
            if (storedReleaseId && storedReleaseName) {
              dispatch(
                setSelectedRelease({
                  selectedReleaseId: storedReleaseId,
                  selectedReleaseName: storedReleaseName,
                }),
              );
            }
          } else {
            if (storedTypeValue === APP_STRINGS.VALUE_SPRINT && storedSprintId && storedSprintName) {
              dispatch(
                setSelectedSprint({
                  selectedSprintId: storedSprintId,
                  selectedSprintName: storedSprintName,
                }),
              );
              handleSprint(storedSprintId);
            }

            if (storedTypeValue === APP_STRINGS.VALUE_RELEASE && storedReleaseId && storedReleaseName) {
              dispatch(
                setSelectedRelease({
                  selectedReleaseId: storedReleaseId,
                  selectedReleaseName: storedReleaseName,
                }),
              );
              handleRelease(storedReleaseId);
            }

            if (storedRepo) {
              dispatch(setSelectedRepository(storedRepo));
            }

            if (storedTypeValue && storedTypeValueLabel) {
              dispatch(
                setSelectedTypeValue({
                  selectedValueLabel: storedTypeValueLabel,
                  selectedValue: storedTypeValue,
                }),
              );
            }
          }
        }
      };

      fetchAndSetData();
    }

    const handleUnload = () => {
      sessionStorage.removeItem('hasRefreshed');
    };

    window.addEventListener('beforeunload', handleUnload);
    return () => window.removeEventListener('beforeunload', handleUnload);
  }, []); // eslint-disable-line react-hooks/exhaustive-deps

//Select back to active sprint when we move from techquality page to any other page
useEffect(() => {
  const currPath = location.pathname;
  const lastPath = sessionStorage.getItem('lastVisitedPath') || '';
  const projectId = sessionStorage.getItem('projectId');
  const boardId = sessionStorage.getItem('boardId');
  const sprintId = sessionStorage.getItem('sprintId');

  const isLeavingTechQuality = lastPath === TECH_QUALITY_PATH && currPath !== TECH_QUALITY_PATH;
  const releaseId = sessionStorage.getItem('releaseId');
  const isDashboardNeedingSprint =
    currPath === DASHBOARD_PATH && projectId && boardId && !sprintId && !releaseId;
  const isStandupNeedingSprint =
    currPath === STANDUP_PATH && projectId && boardId && !sprintId && !releaseId;

  if (currPath === RELEASE_DASHBOARD_PATH) {
    sessionStorage.setItem('lastVisitedPath', currPath);
    return;
  }

  // When navigating from Release Dashboard to Standup, fetch standup-specific data
  const isLeavingReleaseDashboardToStandup = lastPath === RELEASE_DASHBOARD_PATH && currPath === STANDUP_PATH;
  if (isLeavingReleaseDashboardToStandup && projectId && boardId) {
    const typeValue = sessionStorage.getItem(APP_STRINGS.SESSION_TYPE_VALUE);
    (async () => {
      try {
        if (typeValue === APP_STRINGS.VALUE_RELEASE && releaseId) {
          await handleReleaseForStandup(releaseId);
        } else if (sprintId) {
          await handleSprintForStandup(sprintId);
        } else if (releaseId) {
          await handleReleaseForStandup(releaseId);
        } else {
          dispatch(setLoading(true));
          dispatch(setLoadingEngMetrics(true));
          const sprints = (await getSprintList())?.data || [];
          dispatch(setSprintList(sprints));
          const sprintToUse = sprints.find((s) => s.state === 'active' || s.state === 'current')
            || [...sprints].sort((a, b) => new Date(b.endDate) - new Date(a.endDate))[0];
          if (sprintToUse) {
            await handleSprintForStandup(sprintToUse._id);
          } else {
            dispatch(setLoading(false));
            dispatch(setLoadingEngMetrics(false));
          }
        }
      } catch (err) {
        console.error('Error fetching standup data when leaving release dashboard:', err);
        dispatch(setLoading(false));
        dispatch(setLoadingEngMetrics(false));
      }
    })();
    sessionStorage.setItem('lastVisitedPath', currPath);
    return;
  }

  // Skip refetch when navigating to Standup - it uses Redux data and avoids unnecessary loading
  const isNavigatingToStandup = currPath === STANDUP_PATH;
  const state = store.getState();
  const jiraData = state.jira || {};
  const hasMatchingCachedData =
    isNavigatingToStandup &&
    jiraData?.selectedProjectId === projectId &&
    (jiraData?.selectedSprintId === sprintId || jiraData?.selectedReleaseId === sessionStorage.getItem('releaseId')) &&
    (jiraData?.Sprint || jiraData?.Release);

  const shouldSkipRefetch = isNavigatingToStandup && hasMatchingCachedData && !isStandupNeedingSprint;

  if (
    (isLeavingTechQuality || isDashboardNeedingSprint || isStandupNeedingSprint) &&
    projectId &&
    boardId &&
    !shouldSkipRefetch
  ) {
    dispatch(setLoading(true));
    dispatch(setLoadingEngMetrics(true));
    (async () => {
      try {
        const sprints = (await getSprintList())?.data || [];
        dispatch(setSprintList(sprints));

        const storedId = sessionStorage.getItem('sprintId');
        const sprintToUse = sprints.find((s) => s._id === storedId)
          || sprints.find((s) => s.state === 'active' || s.state === 'current')
          || [...sprints].sort((a, b) => new Date(b.endDate) - new Date(a.endDate))[0];

        if (sprintToUse) {
          if (currPath === STANDUP_PATH) {
            await handleSprintForStandup(sprintToUse._id);
          } else {
            await handleSprint(sprintToUse._id);
            fetchData(getReleaseDetails, setReleasesList, { projectId, boardId });
          }
          const typeLabel =
            sessionStorage.getItem(APP_STRINGS.SESSION_TYPE_VALUE_LABEL) || APP_STRINGS.VALUE_SPRINT;
          const typeValue =
            sessionStorage.getItem(APP_STRINGS.SESSION_TYPE_VALUE) || APP_STRINGS.VALUE_SPRINT;
          dispatch(setSelectedTypeValue({ selectedValueLabel: typeLabel, selectedValue: typeValue }));
        } else {
          dispatch(setLoading(false));
          dispatch(setLoadingEngMetrics(false));
        }
      } catch (err) {
        console.error('Error syncing sprint on leave Tech Quality:', err);
        dispatch(setLoading(false));
        dispatch(setLoadingEngMetrics(false));
      }
    })();
  }

  sessionStorage.setItem('lastVisitedPath', currPath);
  // eslint-disable-next-line react-hooks/exhaustive-deps
}, [location.pathname, dispatch]);

  const handleOrganization = async (value, dispatch) => {
    try {
      dispatch(setLoading(true));
      dispatch(setLoadingEngMetrics(true));
      dispatch(setSelectedDeveloperName(''));
      sessionStorage.removeItem('repo');
      sessionStorage.removeItem('developer');
      sessionStorage.removeItem('velocityToggleType');
      sessionStorage.removeItem('velocityToggleTypeManual');
      sessionStorage.removeItem('projectId');
      store.dispatch(resetGit());
      store.dispatch(resetJira());
      store.dispatch(resetCXO());
      store.dispatch(resetSonarQubeData());
      const cachedOrgs = store.getState()?.jira?.organizationList;
      const organizations = cachedOrgs?.length > 0 ? cachedOrgs : await getAllOrgsListAPI();

      const selectedOrg = organizations.find((org) => org._id === value);
      sessionStorage.setItem('companyId', selectedOrg._id);
      sessionStorage.setItem('orgId', selectedOrg._id);
      sessionStorage.setItem('orgName', selectedOrg.companyName);

      dispatch(
        setSelectedOrganization({
          selectedOrgName: selectedOrg.companyName,
          selectedOrgId: selectedOrg._id,
        }),
      );

      dispatch(setIsOrganizationOpen(false));
      dispatch(setLoading(true));
      await fetchData(getProjectList, setProjectList, { companyId: selectedOrg._id });
      dispatch(setLoading(false));
    } catch (error) {
      console.error('Error fetching data on project change:', error);
    } finally {
      dispatch(setLoading(false));
      dispatch(setLoadingEngMetrics(false));
    }
  };
  const handleProject = async (value, boardType = null, dispatch) => {
    if (location.pathname === RELEASE_DASHBOARD_PATH) {
      await handleProjectForReleaseDashboard(value, boardType, dispatch);
      return;
    }
    try {
      dispatch(setLoading(true));
      dispatch(setLoadingEngMetrics(true));
      dispatch(setSelectedDeveloperName(''));
      sessionStorage.removeItem('repo');
      sessionStorage.removeItem('developer');
      store.dispatch(resetGit());
      store.dispatch(resetCXO());
      store.dispatch(resetSonarQubeData());
      sessionStorage.removeItem('repo');
      sessionStorage.removeItem('sprintId');
      sessionStorage.removeItem('sprintName');
      sessionStorage.removeItem('releaseId');
      sessionStorage.removeItem('releaseName');
      sessionStorage.removeItem(APP_STRINGS.SESSION_TYPE_VALUE);
      sessionStorage.removeItem(APP_STRINGS.SESSION_TYPE_VALUE_LABEL);
      sessionStorage.removeItem('developer');
      sessionStorage.removeItem('velocityToggleType');
      sessionStorage.removeItem('velocityToggleTypeManual');
      let projects = [];
      const projectList = store.getState()?.jira?.projectList;
      if (
        projectList === null ||
        projectList === undefined ||
        projectList?.length === 0
      ) {
        const projectsData = await getProjectList();
        projects = projectsData?.data ?? [];
        dispatch(setProjectList(projects));
      } else {
        projects = projectList;
      }
      const selectedProject = projects.find((project) => project._id === value);
      let repositoryPlatform;
      if (
        selectedProject?.repos &&
        Array.isArray(selectedProject?.repos) &&
        selectedProject?.repos.length > 0
      ) {
        const isGitLab = selectedProject?.repos.some(
          (repo) => typeof repo === 'string' && repo.includes('gitlab.com'),
        );
        const isGitHub = selectedProject?.repos.some(
          (repo) => typeof repo === 'string' && repo.includes('github.com'),
        );

        if (isGitLab) {
          repositoryPlatform = 'GitLab';
        } else if (isGitHub) {
          repositoryPlatform = 'GitHub';
        } else {
          repositoryPlatform = 'unknown';
        }
      }
      dispatch(setRepositoryProvider({ repositoryProvider: repositoryPlatform }));
      if (!selectedProject) {
        throw new Error('Selected project not found');
      }
      sessionStorage.setItem('projectId', selectedProject._id);
      sessionStorage.setItem('projectName', selectedProject.name);
      if (boardType) {
        const normalized = String(boardType).toLowerCase();
        sessionStorage.setItem(
          'boardType',
          normalized === 'azure board' ||
            normalized === 'azure-board' ||
            normalized.includes('azure')
            ? 'azure-board'
            : normalized,
        );
      }

      dispatch(
        setSelectedProject({
          selectedProjectName: selectedProject.name,
          selectedProjectId: selectedProject._id,
          sonarQubeCombinedScanReport: selectedProject.combinedScanData,
        }),
      );
      dispatch(setSelectedRelease({}));
      dispatch(setIsProjectOpen(false));

      const listFetchParams = {
        companyId: sessionStorage.getItem('companyId'),
        projectId: selectedProject._id,
        boardId: sessionStorage.getItem('boardId'),
      };
      dispatch(setSprintList([]));
      dispatch(setReleasesList([]));
      await Promise.all([
        fetchData(getSprintList, setSprintList, listFetchParams),
        fetchData(getReleaseDetails, setReleasesList, listFetchParams),
        fetchData(getRepoList, setRepoList, {
          companyId: sessionStorage.getItem('companyId'),
          projectId: selectedProject._id,
        }),
      ]);

      const state = store.getState();
      const jiraData = state.jira;
      let latestUnreleasedRelease, currentSprint;
      const isAzure = String(sessionStorage.getItem('boardType') || boardType || '')
        .toLowerCase()
        .includes('azure');
      const isGitLab = String(sessionStorage.getItem('boardType') || boardType || '')
        .toLowerCase()
        .includes('gitlab');
      
      // const labelSprint = isAzure ? 'Iteration' : 'Sprint';
      const labelRelease = isGitLab
        ? APP_STRINGS.LABEL_MILESTONE
        : isAzure
          ? APP_STRINGS.LABEL_EPIC
          : APP_STRINGS.VALUE_RELEASE;
      const boardTypeKey = String(boardType || '').toLowerCase();
      const isKanbanOrGitLabBoard = ['kanban', 'gitlab-board'].includes(boardTypeKey);
      const sprintListLength = jiraData?.sprintList?.length ?? 0;
      const releasesListLength = jiraData?.releasesList?.length ?? 0;
      const hasNoSprints = sprintListLength === 0;
      const hasReleases = releasesListLength > 0;
      // getBoardList often returns boardType "simple" for both Scrum (with sprints) and release-only boards.
      // Default Release when: Kanban/GitLab, OR sprint API returned none but releases exist for this project+board.
      const useReleaseDefault =
        isKanbanOrGitLabBoard || (hasNoSprints && hasReleases);
      if (useReleaseDefault) {
        latestUnreleasedRelease = jiraData?.releasesList
          ?.filter((release) => release.status?.toLowerCase() === 'unreleased')
          .sort((a, b) => new Date(b.releaseDate) - new Date(a.releaseDate))
          ?.at(0);
        // If no unreleased release found, fallback to latest release (any status)
        if (
          !latestUnreleasedRelease &&
          Array.isArray(jiraData?.releasesList) &&
          jiraData.releasesList.length > 0
        ) {
          latestUnreleasedRelease = [...jiraData.releasesList].sort(
            (a, b) => new Date(b.releaseDate) - new Date(a.releaseDate),
          )[0];
        }

        if (latestUnreleasedRelease) {
          sessionStorage.setItem('releaseId', latestUnreleasedRelease._id);
          dispatch(
            setSelectedTypeValue({
              selectedValueLabel: labelRelease,
              selectedValue: APP_STRINGS.VALUE_RELEASE,
            }),
          );
          dispatch(
            setSelectedRelease({
              selectedReleaseId: latestUnreleasedRelease._id,
              selectedReleaseName: latestUnreleasedRelease.releaseName,
            }),
          );
        }
      } else {
        currentSprint = jiraData?.sprintList?.find((sprint) => sprint.state === 'active' || sprint.state === 'current');
        if (!currentSprint && Array.isArray(jiraData?.sprintList)) {
          const sortedSprints = [...jiraData.sprintList].sort(
            (a, b) => new Date(b.endDate) - new Date(a.endDate),
          );
          currentSprint = sortedSprints[0];
        }
        if (currentSprint) {
          sessionStorage.setItem('sprintId', currentSprint._id);
          dispatch(
            setSelectedTypeValue({
              selectedValueLabel: APP_STRINGS.VALUE_SPRINT,
              selectedValue: APP_STRINGS.VALUE_SPRINT,
            }),
          );
          dispatch(
            setSelectedSprint({
              selectedSprintId: currentSprint._id,
              selectedSprintName: currentSprint.name,
            }),
          );
        }
      }
      repo = null;
      if (Array.isArray(jiraData.repoList) && jiraData.repoList.length > 0) {
        const defaultRepo = [...jiraData.repoList].sort()[0];
        dispatch(setSelectedRepository(defaultRepo));
        sessionStorage.setItem('repo', defaultRepo);
        repo = defaultRepo;
      }
      if (useReleaseDefault) {
        if (latestUnreleasedRelease) {
          await handleRelease(latestUnreleasedRelease._id);
        }
      } else {
        if (currentSprint) {
          await handleSprint(currentSprint._id);
        }
      }
    } catch (error) {
      console.error('Error fetching data on project change:', error);
      const currentProjectId = sessionStorage.getItem('projectId');
      const currentProjectName = sessionStorage.getItem('projectName');

      if (!currentProjectId || !currentProjectName) {
        dispatch(setSelectedProject({ selectedProjectName: '', selectedProjectId: '' }));
        sessionStorage.removeItem('projectId');
        sessionStorage.removeItem('projectName');
      }
    } finally {
      dispatch(setLoading(false));
      dispatch(setLoadingEngMetrics(false));
    }
  };
  const getSonarQubeReportByRepo = (data, repoName) => {
