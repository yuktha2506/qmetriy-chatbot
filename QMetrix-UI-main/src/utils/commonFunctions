      sessionStorage.setItem(APP_STRINGS.SESSION_TYPE_VALUE, APP_STRINGS.VALUE_RELEASE);
      sessionStorage.setItem(APP_STRINGS.SESSION_TYPE_VALUE_LABEL, APP_STRINGS.VALUE_RELEASE);
      if (selectedRelease?.hours === true) {
        sessionStorage.setItem('isHoursBasedProject', 'true');
      } else {
        sessionStorage.setItem('isHoursBasedProject', 'false');
        {
        const isAzure = String(sessionStorage.getItem('boardType') || '')
          .toLowerCase()
          .includes('azure');
        const labelRelease = isAzure ? APP_STRINGS.LABEL_EPIC : APP_STRINGS.VALUE_RELEASE;
        sessionStorage.setItem(APP_STRINGS.SESSION_TYPE_VALUE_LABEL, labelRelease);
      }
      }
      dispatch(setSelectedSprint({ selectedSprintId: '', selectedSprintName: '' }));
