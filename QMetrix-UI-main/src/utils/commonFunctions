        repo: sessionStorage.getItem('repo'),
        developer: sessionStorage.getItem('developer'),
        estimationType: sessionStorage.getItem('isHoursBasedProject') === 'true' ? 'hours' : 'storyPoints',
      };
      // For testing purposes we are using unified endpoints. If they work properly, we will remove the commented code later.
      // const isHoursBasedProject = sessionStorage.getItem('isHoursBasedProject') === 'true';
      // const burndownVelocityQuery = {
      //   ...matchReleaseQuery,
      //   type: isHoursBasedProject ? 'hours' : 'storyPoints',
      // };
      // await fetchData(getReleaseReadinessDetails, addReleaseReadinessData, matchReleaseQuery);

      const path = location.pathname;
      const query = matchReleaseQuery;

      if (path === DASHBOARD_PATH) {
        // Priority: Dashboard needs CXO Data first
        await fetchCXODashboardData(query);
        // Pre-load background data for other pages
        await Promise.all([
          fetchProjectManagementData(query),
          fetchStandupDashboardData(query),
          repo ? fetchGitDashboardData(query) : Promise.resolve(),
        ]);
      } else if (path === JIRA_PATH) {
        // Priority: Engineering (Jira) needs PM Data first
        await fetchProjectManagementData(query);
        // Pre-load background data for other pages
        await Promise.all([
          fetchCXODashboardData(query),
          fetchStandupDashboardData(query),
          repo ? fetchGitDashboardData(query) : Promise.resolve(),
        ]);
      } else if (path === STANDUP_PATH) {
        // Priority: Standup page needs Standup Data first
        await fetchStandupDashboardData(query);
        // Pre-load background data for other pages
        await Promise.all([
          fetchProjectManagementData(query),
          fetchCXODashboardData(query),
          repo ? fetchGitDashboardData(query) : Promise.resolve(),
        ]);
      } else if (path === GIT_PATH && repo) {
        // Priority: Git page needs Git Data first
        await fetchGitDashboardData(query);
        // Pre-load background data for other pages
        await Promise.all([
          fetchProjectManagementData(query),
          fetchCXODashboardData(query),
          fetchStandupDashboardData(query),
        ]);
      } else {
        // Default: Parallelize all if path doesn't match specific priorities
        await Promise.all([
          fetchCXODashboardData(query),
          fetchProjectManagementData(query),
          fetchStandupDashboardData(query),
          repo ? fetchGitDashboardData(query) : Promise.resolve(),
