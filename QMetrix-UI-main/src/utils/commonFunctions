        return;
      }
      sessionStorage.setItem('repo', selectedRepo);
      dispatch(setSelectedRepository(selectedRepo));

      const projectId = sessionStorage.getItem('projectId');
      const allSprintsResp = await getSprintList({ projectId });
      const allReleasesResp = await getReleaseDetails({ projectId });

      const allSprints = allSprintsResp?.data || [];
      const allReleases = allReleasesResp?.data || [];

      const currentSprintId = sessionStorage.getItem('sprintId');
      const currentReleaseId = sessionStorage.getItem('releaseId');

      const sprintStillValid = allSprints.some((s) => s._id === currentSprintId);
      const releaseStillValid = allReleases.some((r) => r._id === currentReleaseId);

      if (!sprintStillValid) {
        dispatch(setSelectedSprint({ selectedSprintId: '', selectedSprintName: '' }));
        sessionStorage.removeItem('sprintId');
        sessionStorage.removeItem('sprintName');
      }

      if (!releaseStillValid) {
        dispatch(setSelectedRelease({ selectedReleaseId: '', selectedReleaseName: '' }));
        sessionStorage.removeItem('releaseId');
        sessionStorage.removeItem('releaseName');
      }
    } catch (error) {
      console.error('Error fetching data on repo change:', error);
    }
  };

  const handleDeveloper = async (value) => {
    try {
      dispatch(setLoading(true));
      dispatch(setLoadingEngMetrics(true));

      sessionStorage.setItem('developer', value);
      const isSprint = sessionStorage.getItem(APP_STRINGS.SESSION_TYPE_VALUE);
      const isRelease = isSprint === APP_STRINGS.VALUE_RELEASE;

      const matchSprintQuery = {
        companyId: sessionStorage.getItem('companyId'),
        projectId: sessionStorage.getItem('projectId'),
        boardId: sessionStorage.getItem('boardId'),
        repo: sessionStorage.getItem('repo'),
        value: isRelease ? APP_STRINGS.API_RELEASE : APP_STRINGS.API_SPRINT,
        developer: value,
        estimationType: sessionStorage.getItem('isHoursBasedProject') === 'true' ? 'hours' : 'storyPoints',
        ...(isRelease
          ? { releaseId: sessionStorage.getItem('releaseId') }
          : { sprintId: sessionStorage.getItem('sprintId') }),
      };
      // For testing purposes we are using unified endpoints. If they work properly, we will remove the commented code later.
      // const isHoursBasedProject = sessionStorage.getItem('isHoursBasedProject') === 'true';
      // const burndownVelocityQuery = {
      //   ...matchSprintQuery,
      //   type: isHoursBasedProject ? 'hours' : 'storyPoints',
      // };

      dispatch(setSelectedDeveloperName({ value }));

      const developerPmSections = 'userList,actualStoryPoints,burndownData,availableHours,burndownVelocity,qaInsightsBugs,qaInsightsTests';
      const fetchPromises = [
        // --- Unified project management endpoint (scoped sections for developer change) ---
        fetchProjectManagementData(matchSprintQuery, developerPmSections),
        // --- Unified standup endpoint (scoped sections for developer change) ---
        fetchStandupDashboardData(matchSprintQuery, 'jiraData,jiraStatusByDev,standupBurndown,openPRs,mergedWithoutReview,storyChurn,storyChurnExcludingBugs,dailyBurnup'),
        // For testing purposes we are using this change. If this endpoint works properly, we will remove the commented code later.
        // fetchData(fetchJiraStatusByDeveloper, setJiraStatusByDeveloper, matchSprintQuery),
        // fetchData(getjiraTableData, setJiraTableData, matchSprintQuery),
        // fetchData(getOpenPRsData, setStandupOpenPRsData, matchSprintQuery),
        // fetchData(getMergedPRsWithoutReviewData, setStandupMergedPRsData, matchSprintQuery),
        // fetchData(getStandupBurndown, setStandupBurndown, matchSprintQuery),
      ];

      await Promise.all(fetchPromises);
    } catch (error) {
      console.error('Error resetting sprint and release:', error);
    } finally {
      dispatch(setLoading(false));
      dispatch(setLoadingEngMetrics(false));
